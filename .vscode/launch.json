{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug React App",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "type": "pwa-chrome",
      "request": "attach",
      "name": "Attach to Chrome (9222)",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ]
}
